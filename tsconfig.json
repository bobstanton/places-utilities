{
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2020",
    "allowJs": true,
    "noImplicitAny": false,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "src",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],
    "skipLibCheck": true,
    "paths": {
      "places-utilities/core": [
        "./src/core/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "./globals.d.ts"
  ]
}
